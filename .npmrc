# O better-sqlite3 já traz binários prontos (prebuilds) para Linux, Windows e
# macOS. Sem esta opção, o npm tenta compilá-lo do zero (node-gyp), o que
# exige compilador C++ e falha em máquinas sem essas ferramentas.
# Nenhuma outra dependência do projeto usa scripts de instalação.
ignore-scripts=true
